PORT=3000

# Secret used to sign login sessions (JWT). Change this to a long random string.
JWT_SECRET=change_this_to_a_long_random_secret

# Stress level (0-10) at which MindPlay sends the first early-warning SMS.
ALERT_THRESHOLD=5

# Minimum minutes between two SMS alerts for the same user.
ALERT_COOLDOWN_MINUTES=5

# Optional: Twilio credentials for real SMS sending.
# If left empty, MindPlay runs in "stub mode" and just logs alerts to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
